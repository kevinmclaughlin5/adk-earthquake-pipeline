# Copy this file to .env and fill in your values. Never commit .env.

# --- Gemini (the agent's LLM) ---
# Free key from Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Storage ---
# gcs   = upload to Google Cloud Storage (requires GCS_BUCKET + gcloud auth)
# local = skip the upload, keep files in ./output only
STORAGE_BACKEND=gcs
GCS_BUCKET=your-bucket-name
